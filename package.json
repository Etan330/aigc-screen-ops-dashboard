{
  "name": "aigc-screen-ops-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AIGC 互动大屏运营数据看板（招聘测评演示项目，全部为模拟数据）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
